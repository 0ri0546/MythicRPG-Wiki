---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeExplorer from '../../components/RecipeExplorer.astro';
import { catalog } from '../../lib/catalog';
---
<BaseLayout title="Recettes">
  <header class="page-header"><p class="eyebrow">Données JSON interactives</p><h1>Recettes</h1><p>{catalog.recipes.length} recettes lues dans les datapacks du mod, filtrables par résultat, ingrédient et type.</p></header>
  <RecipeExplorer recipes={catalog.recipes} />
</BaseLayout>
